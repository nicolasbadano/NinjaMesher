// Fixture for Tests/test_dictdupkey.sh. A duplicate dict key used to be a
// SILENT overwrite: two refinement regions named the same collapsed to the
// last one, and nothing said so.
// The level-2 region ALONE -- what the distinct-name dict must equal.
domain { min (0 0 0); max (1 1 1); n (10 10 10); }
patches { xmin { type patch; name inlet; } xmax { type patch; name outlet; }
          ymin { type wall; name w1; } ymax { type wall; name w2; }
          zmin { type wall; name w3; } zmax { type wall; name w4; } }
geometry { sphere.stl { name sphere; } }
locationInMesh (0.05 0.05 0.05);
refinement
{
    only { type box; min (0 0 0); max (1 1 1); level 2; }
}
