// A vertical wall, rotated 17 deg about z, crossing three refinement levels stacked in z
// (1 / 2 / 3), with the bm_layers_wfp layer request (6 layers, ratio 1.8).
domain
{
    min   (0 0 0);
    max   (1 0.5 1.2);
    n     (10 5 12);
}

patches
{
    xmin { type patch; name inlet;  }
    xmax { type patch; name outlet; }
    ymin { type patch; name front;  }
    ymax { type patch; name back;   }
    zmin { type wall;  name bottom; }
    zmax { type patch; name top;    }
}

geometry
{
    wall.stl { name wall; }
}

locationInMesh (0.05 0.05 0.05);

refinement
{
    nearWall { type surface; stl wall.stl; distance 0.15; level 1; }
    mid      { type box; min (0.6 0 0.4); max (1 0.5 0.8); level 2; }
    upper    { type box; min (0.6 0 0.8); max (1 0.5 1.2); level 3; }
}

layers
{
    wall.stl { nLayers 6; expansionRatio 1.8; finalLayerThickness 0.3; }
}
