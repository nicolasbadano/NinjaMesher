FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.53e-05;

boundaryField
{
    inlet       { type fixedValue;      value $internalField; }
    outlet      { type inletOutlet;     inletValue $internalField; value $internalField; }
    atmosphere  { type inletOutlet;     inletValue $internalField; value $internalField; }
    "(cresta|pilas|fondo|compuertas|muros|talud)"
    {
        type            kqRWallFunction;
        value           uniform 0.0001;
    }
    "(side_ymin|side_ymax|bottom)" { type zeroGradient; }
}

