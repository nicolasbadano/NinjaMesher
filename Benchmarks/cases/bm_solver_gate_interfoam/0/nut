FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet       { type calculated; value uniform 0; }
    outlet      { type calculated; value uniform 0; }
    atmosphere  { type calculated; value uniform 0; }
    "(cresta|pilas|fondo|muros)"
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.0015;
        Cs              uniform 0.5;
        value           uniform 0;
    }
    compuertas
    {
        type            nutkRoughWallFunction;
        Ks              uniform 1.5e-05;
        Cs              uniform 0.5;
        value           uniform 0;
    }
    talud
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.005;
        Cs              uniform 0.5;
        value           uniform 0;
    }
    "(side_ymin|side_ymax|bottom)" { type calculated; value uniform 0; }
}

