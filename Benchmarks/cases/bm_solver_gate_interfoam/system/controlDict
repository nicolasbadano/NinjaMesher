FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     interFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.2;

deltaT          0.001;
adjustTimeStep  on;
maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       0.01;

writeControl    runTime;
writeInterval   2;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable no;

// ************************************************************************* //
