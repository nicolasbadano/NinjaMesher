domain
{
    min (-60 -53 -4);
    max (130  39 14);
    n   (190 92 18);
}

patches
{
    xmin { type patch; name inlet; }
    xmax { type patch; name outlet; }
    ymin { type wall;  name side_ymin; }
    ymax { type wall;  name side_ymax; }
    zmin { type wall;  name bottom; }
    zmax { type patch; name atmosphere; }
}

geometry
{
    compuertasG05.stl { name compuertas; }
    crestaG05.stl     { name cresta; }
    fondoG05.stl      { name fondo; }
    pilasG05.stl      { name pilas; }
    taludG05.stl      { name talud; }
    murosG05.stl      { name muros; }
}

locationInMesh (0.01 0.01 0.01);

refinement
{
    nearCompuertas { type surface; stl compuertasG05.stl; distance 0.25; level 3; }
    nearPilas      { type surface; stl pilasG05.stl;      distance 0.75; level 2; }
    nearCresta     { type surface; stl crestaG05.stl;     distance 1.0;  level 1; }
    centerBox      { type box; min (-7 -53 -4); max (5 39 4); level 1; }
}

layers
{
    compuertasG05.stl { nLayers 4; expansionRatio 1.5; finalLayerThickness 0.4; }
    pilasG05.stl      { nLayers 4; expansionRatio 1.5; finalLayerThickness 0.4; }
}
