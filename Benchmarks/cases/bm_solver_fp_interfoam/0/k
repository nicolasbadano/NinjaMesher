FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.53e-05;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    "(outlet|top)"
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    "(passage|bed|side_zmin|side_zmax)"
    {
        type            kqRWallFunction;
        value           $internalField;
    }
}

