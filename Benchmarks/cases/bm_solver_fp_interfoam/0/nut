FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(inlet|outlet|top)"
    {
        type            calculated;
        value           uniform 0;
    }

    "(passage|bed|side_zmin|side_zmax)"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
}

