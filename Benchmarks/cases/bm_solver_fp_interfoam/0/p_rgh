FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
    }

    outlet
    {
        type            uniformMixed;
        uniformValue    constant 11772;
        uniformGradient constant 0;
        uniformValueFraction
        {
            type        expression;
            expression  "min(max((1.2 - pos().y())*5, 0), 1)";
        }
        value           uniform 0;
    }

    top
    {
        type            totalPressure;
        p0              uniform 0;
    }

    "(passage|bed|side_zmin|side_zmax)"
    {
        type            fixedFluxPressure;
    }
}

// ************************************************************************* //
