FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inletWeir   { type fixedFluxPressure; value uniform 0; }
    inletB      { type fixedFluxPressure; value uniform 0; }
    outlet      { type prghTotalPressure; p0 uniform 0; value uniform 0; }
    fixedWalls  { type fixedFluxPressure; value uniform 0; }
    atmosphere  { type totalPressure; p0 uniform 0; value uniform 0; }
    side_ymin   { type fixedFluxPressure; value uniform 0; }
    side_ymax   { type fixedFluxPressure; value uniform 0; }
    bed         { type fixedFluxPressure; value uniform 0; }
}
