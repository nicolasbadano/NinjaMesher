FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 0.063;

boundaryField
{
    inletWeir   { type fixedValue; value uniform 0.063; }
    inletB      { type fixedValue; value uniform 0.85; }
    outlet      { type inletOutlet; inletValue $internalField; value $internalField; }
    fixedWalls  { type omegaWallFunction; value $internalField; }
    atmosphere  { type inletOutlet; inletValue $internalField; value $internalField; }
    side_ymin   { type omegaWallFunction; value $internalField; }
    side_ymax   { type omegaWallFunction; value $internalField; }
    bed         { type omegaWallFunction; value $internalField; }
}
