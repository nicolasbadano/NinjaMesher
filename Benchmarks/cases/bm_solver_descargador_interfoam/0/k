FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0.00010;

boundaryField
{
    inlet       { type fixedValue; value uniform 0.00011; }
    outlet      { type inletOutlet; inletValue $internalField; value $internalField; }
    atmosphere  { type inletOutlet; inletValue $internalField; value $internalField; }
    symmetry    { type zeroGradient; }
    fixedWalls  { type kqRWallFunction; value $internalField; }
    aireador    { type inletOutlet; inletValue uniform 0.24; value uniform 0.24; }
}
